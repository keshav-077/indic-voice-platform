# BharatVoiceAI — Environment Configuration
# Copy to .env and fill in your values. Never commit .env to git.

# App
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO
WARMUP_MODELS=false

# Security (change before deploying)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
VAI_JWT_SECRET=CHANGE_ME_GENERATE_WITH_secrets_token_hex_32
VAI_API_KEY_SALT=CHANGE_ME_GENERATE_WITH_secrets_token_hex_16
STATIC_API_KEYS=your-api-key-here

# BHASHINI (Government of India, free PoC tier)
# Register at: https://bhashini.gov.in/ulca/user/register
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=

# Sarvam AI (for LLM/NLU features)
SARVAM_API_KEY=

# Model backends (per service)
VAI_ASR_BACKEND=indicwhisper        # indicwhisper | bhashini | wav2vec2 | local
VAI_MT_BACKEND=indictrans2          # indictrans2 | bhashini | sarvam
VAI_TTS_BACKEND=indic_parler        # indic_parler | bhashini
VAI_LID_BACKEND=smart               # smart | indiclid | bhashini | local
VAI_NLU_BACKEND=rule                # rule | llm | rule+llm

# Model paths
# Some models are gated on HuggingFace. Before first use:
# 1. Run: huggingface-cli login
# 2. Accept access at: https://huggingface.co/ai4bharat/indic-parler-tts
# 3. Accept access at: https://huggingface.co/ai4bharat/IndicLID-FTR
MODEL_CACHE_DIR=/tmp/vai_models
INDICTRANS2_MODEL=ai4bharat/indictrans2-en-indic-1B
INDICWHISPER_MODEL=openai/whisper-large-v3
INDIC_PARLER_MODEL=ai4bharat/indic-parler-tts
INDICLID_MODEL=ai4bharat/IndicLID
DEVICE=auto                         # auto | cpu | cuda | cuda:0

# Database (optional — leave empty to run without a database)
# All AI services work without a DB. DB is only used for rate limiting state.
VAI_DB_URL=
DB_POOL_SIZE=10

# Redis
VAI_REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# Rate limiting
RATE_LIMIT_DEFAULT_RPM=60
RATE_LIMIT_ASR_RPM=30
RATE_LIMIT_MT_RPM=120
RATE_LIMIT_TTS_RPM=60

# Privacy (DPDP 2023)
# These defaults are privacy-protective. Don't change without legal review.
VAI_AUDIO_LOGGING=false
VAI_PII_MASKING=true
VAI_DATA_RETENTION_DAYS=0
CONSENT_REQUIRED=true

# Audio limits
AUDIO_UPLOAD_MAX_MB=25
MAX_AUDIO_DURATION_SEC=120
MAX_TEXT_CHARS=5000
ASR_TARGET_SAMPLE_RATE=16000

# Object storage (optional, for large TTS outputs)
OBJECT_STORAGE_URL=
OBJECT_STORAGE_BUCKET=vai-audio

# Monitoring
PROMETHEUS_ENABLED=true
SENTRY_DSN=

# CORS
CORS_ORIGINS=["*"]
